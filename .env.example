# Copy to .env and point at your existing PostgreSQL instance.
NODE_ENV=development
PORT=3001

# Full connection string, e.g.
# postgres://user:password@host:5432/database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/my_nuxtjs_backend

# Set to true when the server requires TLS (most managed providers do).
DATABASE_SSL=false

# Connection pool sizing.
DATABASE_POOL_MAX=10

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# Secret used to sign login JWTs. MUST be set to a long random value in
# production — the default is insecure and for local dev only.
JWT_SECRET=dev-only-insecure-secret-change-me

# Token lifetime in seconds (default 24h).
JWT_EXPIRES_IN_SECONDS=86400
